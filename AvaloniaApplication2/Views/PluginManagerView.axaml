<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AvaloniaApplication2.Views.PluginManagerView"
             xmlns:avaloniaConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:converters="using:AvaloniaApplication2.Converters">
    
    <Grid>
        <!-- 拖拽覆盖层 -->
        <Border Name="DragOverlay" 
                IsVisible="False"
                Background="#CC0078D4" ZIndex="999"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                <TextBlock Text="📦" FontSize="64" Foreground="White"/>
                <TextBlock Text="释放以加载插件" FontSize="20" Foreground="White" FontWeight="Medium"/>
            </StackPanel>
        </Border>

        <ScrollViewer Padding="30">
            <StackPanel Spacing="20">
                
                <!-- 标题栏 -->
                <StackPanel Spacing="5">
                    <TextBlock Text="插件管理" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

                <!-- 拖拽区域提示 - 使用 Border -->
                <Border Classes="Card" 
                        BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="2" 
                        Padding="40"
                        DragDrop.AllowDrop="True">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="拖拽 DLL 文件到此处" FontSize="16" Foreground="{DynamicResource SystemAccentColor}" 
                                   HorizontalAlignment="Center" FontWeight="Medium"/>
                        <TextBlock Text="或者将文件拖拽到窗口任意位置" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 插件列表 -->
                <StackPanel Spacing="10">
                    <TextBlock Text="已安装的插件" FontSize="18" FontWeight="SemiBold"/>
                    
                    <ItemsControl ItemsSource="{Binding Plugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 插件卡片 - 使用 Border -->
                                <Border Classes="Card" Margin="0,0,0,10" Padding="15">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Grid.ColumnSpacing>15</Grid.ColumnSpacing>
                                        
                                        <!-- 插件图标 -->
                                        <Border Grid.Column="0" Width="50" Height="50" 
                                                Background="{DynamicResource SystemControlBackgroundListLowBrush}" CornerRadius="8"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🔌" FontSize="24" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- 插件信息 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Name}" FontSize="16" 
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Version}" FontSize="12" 
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="13" 
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Author}" FontSize="12" 
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                            
                                            <!-- 错误信息 -->
                                            <Border IsVisible="{Binding Error, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}"
                                                    Background="#FFFDE7" BorderBrush="#FFCDD2" BorderThickness="1" CornerRadius="4" Padding="10">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="❌ 错误" FontSize="13" FontWeight="SemiBold" Foreground="#D32F2F"/>
                                                    <TextBlock Text="{Binding Error}" FontSize="12" Foreground="#D32F2F" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 操作按钮 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <!-- 启用/禁用开关 -->
                                            <ToggleButton Width="50" Height="28" 
                                                          IsChecked="{Binding IsEnabled}"/>

                                            <!-- 打开插件 -->
                                            <Button Content="打开" Height="32" Padding="15,0"
                                                    Classes="SuggestedAction"
                                                    Command="{Binding $parent[ItemsControl].DataContext.OpenPluginCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    IsEnabled="{Binding IsEnabled}"/>

                                            <!-- 停止/启动按钮 -->
                                            <Button Height="32" Padding="15,0"
                                                    Command="{Binding $parent[ItemsControl].DataContext.StopPluginCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    Content="{Binding IsRunning, Converter={StaticResource BoolToStringConverter}, ConverterParameter='停止|启动'}"
                                                    Background="{Binding IsRunning, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#FF9800|#4CAF50'}"
                                                    Foreground="White"/>

                                            <!-- 卸载 -->
                                            <Button Content="卸载" Height="32" Padding="15,0"
                                                    Classes="Danger"
                                                    Command="{Binding $parent[ItemsControl].DataContext.UninstallPluginCommand}"
                                                    CommandParameter="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态 - 使用 Border -->
                    <Border Classes="Card" Padding="60" IsVisible="{Binding Plugins.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter='Invert'}">
                        <StackPanel HorizontalAlignment="Center" Spacing="15">
                            <TextBlock Text="📭" FontSize="64" HorizontalAlignment="Center"/>
                            <TextBlock Text="暂无插件" FontSize="18" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="拖拽 DLL 文件到上方区域或窗口任意位置开始添加插件" FontSize="14" 
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>