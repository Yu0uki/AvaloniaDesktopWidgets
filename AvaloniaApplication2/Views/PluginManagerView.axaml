<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AvaloniaApplication2.Views.PluginManagerView"
             xmlns:avaloniaConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:converters="using:AvaloniaApplication2.Converters"
             xmlns:core="clr-namespace:AvaloniaApplication2.Core">

    <Grid>
        <!-- 拖拽覆盖层 -->
        <Border Name="DragOverlay"
                Opacity="0" IsHitTestVisible="False"
                Background="#CC0078D4" ZIndex="999"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                <TextBlock Text="{x:Static core:FluentIcons.DragDrop}" FontFamily="Segoe Fluent Icons" FontSize="64" Foreground="White"/>
                <TextBlock Text="释放以加载插件" FontSize="20" Foreground="White" FontWeight="Medium"/>
            </StackPanel>
        </Border>

        <ScrollViewer Padding="30">
            <StackPanel Spacing="20">

                <!-- 标题栏 -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="插件管理" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Padding="12,8"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentBrush}"
                                CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                Command="{Binding RefreshPluginsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Static core:FluentIcons.Refresh}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                <TextBlock Text="刷新"/>
                            </StackPanel>
                        </Button>
                        <Button Padding="12,8"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="#D83B01"
                                CornerRadius="6" BorderBrush="#D83B01" BorderThickness="1"
                                Command="{Binding ToggleRecycleBinCommand}">
                            <TextBlock Text="回收站"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 回收站面板 -->
                <Border IsVisible="{Binding ShowRecycleBin}"
                        Classes="card" Padding="16" Margin="0,0,0,8"
                        BorderBrush="#D83B01" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="回收站" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Padding="8,4"
                                    Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                    CornerRadius="4" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Command="{Binding RefreshRecycleBinCommand}">
                                <TextBlock Text="刷新" FontSize="11"/>
                            </Button>
                            <Button Grid.Column="2" Padding="8,4"
                                    Background="Transparent" Foreground="#D13438"
                                    CornerRadius="4" BorderBrush="#D13438" BorderThickness="1"
                                    Command="{Binding EmptyRecycleBinCommand}">
                                <TextBlock Text="清空" FontSize="11"/>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RecycleBinItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="0,0,0,2"
                                            Background="{DynamicResource BorderBrush}" CornerRadius="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="{Binding}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Padding="8,4" FontSize="11"
                                                    Background="#107C10" Foreground="White"
                                                    CornerRadius="4"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RestoreFromRecycleBinCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="恢复"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="回收站为空" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding RecycleBinItems.Count, Converter={StaticResource InvertBoolConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- 拖拽区域提示 -->
                <Border Classes="card" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                        Background="{DynamicResource CardBackgroundBrush}" Padding="40"
                        DragDrop.AllowDrop="True">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <TextBlock Text="{x:Static core:FluentIcons.DragDrop}" FontFamily="Segoe Fluent Icons" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="拖拽 DLL 文件到此处" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" FontWeight="Medium"/>
                        <TextBlock Text="或者将文件拖拽到窗口任意位置" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 插件列表 -->
                <StackPanel Spacing="10">
                    <TextBlock Text="已安装的插件" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <ItemsControl ItemsSource="{Binding Plugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="3,*,Auto">
                                        <!-- 状态指示条 -->
                                        <Border Grid.Column="0" Width="3" CornerRadius="1,0,0,1">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource PluginStatusBorderBrushConverter}">
                                                    <Binding Path="IsEnabled"/>
                                                    <Binding Path="IsRunning"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>

                                        <!-- 插件信息区 -->
                                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="12,0,0,0">
                                            <!-- 插件图标（按 ID 区分） -->
                                            <Border Grid.Column="0" Width="48" Height="48"
                                                    Background="{DynamicResource BorderBrush}" CornerRadius="8"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Id, Converter={StaticResource PluginIconConverter}}"
                                                           FontFamily="Segoe Fluent Icons" FontSize="24"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 插件信息 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Name}" FontSize="15"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Version}" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="13"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Author}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Error}" FontSize="12"
                                                           Foreground="#D13438" TextWrapping="Wrap"
                                                           IsVisible="{Binding Error, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 操作按钮区：统一右对齐 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                                            <ToggleButton Width="50" Height="28"
                                                          IsChecked="{Binding IsEnabled}">
                                                <ToggleButton.Styles>
                                                    <Style Selector="ToggleButton:checked">
                                                        <Setter Property="Background" Value="#107C10"/>
                                                    </Style>
                                                </ToggleButton.Styles>
                                            </ToggleButton>

                                            <Button Height="32" Padding="15,0"
                                                    Background="#0078D4" Foreground="White"
                                                    CornerRadius="4" FontSize="12"
                                                    Command="{Binding $parent[ItemsControl].DataContext.OpenPluginCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    IsEnabled="{Binding IsEnabled}">
                                                <TextBlock Text="打开"/>
                                            </Button>

                                            <Button Height="32" Padding="15,0"
                                                    CornerRadius="4" FontSize="12"
                                                    Command="{Binding $parent[ItemsControl].DataContext.StopPluginCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    Content="{Binding IsRunning, Converter={StaticResource BoolToStringConverter}, ConverterParameter='停止|启动'}"
                                                    Background="{Binding IsRunning, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#FF9800|#4CAF50'}"
                                                    Foreground="White"/>

                                            <Button Height="32" Padding="15,0"
                                                    Background="{DynamicResource CardBackgroundBrush}" Foreground="#D13438"
                                                    CornerRadius="4" FontSize="12"
                                                    BorderBrush="#D13438" BorderThickness="1"
                                                    Command="{Binding $parent[ItemsControl].DataContext.UninstallPluginCommand}"
                                                    CommandParameter="{Binding Id}">
                                                <TextBlock Text="卸载"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态 -->
                    <Border Name="EmptyStateBorder" Classes="card" Padding="60">
                        <StackPanel HorizontalAlignment="Center" Spacing="15">
                            <TextBlock Text="{x:Static core:FluentIcons.Empty}" FontFamily="Segoe Fluent Icons" FontSize="64" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="暂无插件" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="拖拽 DLL 文件到上方区域或窗口任意位置开始添加插件" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
