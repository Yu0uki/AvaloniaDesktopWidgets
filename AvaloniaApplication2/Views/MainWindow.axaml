<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AvaloniaApplication2.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="AvaloniaApplication2.MainWindow"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="AcrylicBlur">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding FocusSearchCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <!-- 顶部栏样式 -->
        <Style Selector="Border.topbar">
            <Setter Property="Background" Value="{DynamicResource TopBarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="48"/>
        </Style>

        <!-- 搜索框样式 -->
        <Style Selector="Border.search-box">
            <Setter Property="Background" Value="{DynamicResource SearchBoxBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Width" Value="320"/>
        </Style>

        <!-- 搜索框获得焦点时 -->
        <Style Selector="Border.search-box:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SearchBoxFocusBackgroundBrush}"/>
        </Style>

        <!-- 导航按钮样式 -->
        <Style Selector="Button.nav-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Button.nav-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        
        <Style Selector="Button.nav-button.active">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- 窗口控制按钮 -->
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="{DynamicResource WindowControlHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 按钮通用样式 -->
        <Style Selector="Button">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <!-- 主布局：三段式（顶部栏 + 侧边栏 + 主内容区） -->
    <Grid RowDefinitions="Auto,*">
        
        <!-- 顶部栏 -->
        <Border Grid.Row="0" Classes="topbar" PointerPressed="OnTopBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- 左侧：Logo 和标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="⚡" FontSize="20" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding WindowTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 中间：搜索框 -->
                <Border Grid.Column="1" Classes="search-box" HorizontalAlignment="Center" Margin="0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery}" 
                                 Watermark="搜索应用、文件或网页..."
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="13"
                                 VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Background="{DynamicResource ShortcutKeyBackgroundBrush}" CornerRadius="4" Padding="4,2" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- 右侧：窗口控制按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Classes="window-control" Content="─" Command="{Binding MinimizeWindowCommand}"/>
                    <Button Classes="window-control" Command="{Binding ToggleMaximizeCommand}">
                        <TextBlock Text="{Binding IsMaximized, Converter={StaticResource BoolToStringConverter}, ConverterParameter='❐|'}" FontSize="10"/>
                    </Button>
                    <Button Classes="window-control close" Content="✕" Command="{Binding CloseWindowCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体区域：侧边栏 + 主内容区 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            
            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Width="{Binding SidebarWidth}" 
                    Background="{DynamicResource SidebarBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto,Auto">
                    
                    <!-- 上方：系统导航 -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Top" Spacing="4" Margin="0,12,0,0">
                        
                        <!-- 折叠/展开菜单按钮 -->
                        <Button Classes="nav-button" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="折叠菜单">
                            <TextBlock Text="☰" FontSize="18" HorizontalAlignment="Center"/>
                        </Button>
                        
                        <Separator Background="{DynamicResource BorderBrush}" Margin="8,8"/>
                        
                        <!-- 仪表盘 -->
                        <Button Classes="nav-button" Command="{Binding NavigateToDashboardCommand}" 
                                ToolTip.Tip="仪表盘"
                                IsVisible="{Binding !IsShowingPluginView}"
                                Tag="{Binding SelectedNavIndex, Mode=OneWay}"
                                Classes.active="{Binding SelectedNavIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}">
                            <TextBlock Text="🏠" FontSize="20" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- 返回按钮（仅在显示插件视图时显示） -->
                        <Button Classes="nav-button" Command="{Binding NavigateBackToDashboardCommand}" 
                                ToolTip.Tip="返回主页"
                                IsVisible="{Binding IsShowingPluginView}"
                                Background="#E3F2FD">
                            <TextBlock Text="←" FontSize="20" HorizontalAlignment="Center" Foreground="#0078D4"/>
                        </Button>

                        <!-- 插件管理 -->
                        <Button Classes="nav-button" Command="{Binding NavigateToPluginManagerCommand}"
                                ToolTip.Tip="插件管理"
                                IsVisible="{Binding !IsShowingPluginView}"
                                Classes.active="{Binding SelectedNavIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}">
                            <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- 设置 -->
                        <Button Classes="nav-button" Command="{Binding NavigateToSettingsCommand}"
                                ToolTip.Tip="设置"
                                IsVisible="{Binding !IsShowingPluginView}"
                                Classes.active="{Binding SelectedNavIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}">
                            <TextBlock Text="⚙️" FontSize="20" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    
                    <!-- 中间：可拖拽分隔线 -->
                    <GridSplitter Grid.Row="1" Height="4" 
                                  Background="{DynamicResource BorderBrush}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ShowsPreview="True"
                                  IsVisible="{Binding RunningPlugins.Count, Converter={StaticResource IntToBoolConverter}}">
                        <GridSplitter.Styles>
                            <Style Selector="GridSplitter:pointerover">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Style>
                        </GridSplitter.Styles>
                    </GridSplitter>
                    
                    <!-- 下方：插件列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MinHeight="50"
                                  IsVisible="{Binding RunningPlugins.Count, Converter={StaticResource IntToBoolConverter}}">
                        <ItemsControl ItemsSource="{Binding RunningPlugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="nav-button" 
                                            Command="{Binding $parent[Window].DataContext.NavigateToPluginCommand}"
                                            CommandParameter="{Binding Id}"
                                            ToolTip.Tip="{Binding Name}">
                                        <TextBlock Text="🔌" FontSize="20" HorizontalAlignment="Center"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 主内容区域 -->
            <Grid Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
                <ContentControl Content="{Binding CurrentPage}"/>
                
                <!-- 通知区域 -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Margin="0,20,20,0" Width="350" MaxHeight="400"
                        IsHitTestVisible="False">
                    <ItemsControl ItemsSource="{Binding Notifications}" 
                                  x:DataType="vm:MainWindowViewModel"
                                  HorizontalAlignment="Right">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NotificationMessage">
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" 
                                        BoxShadow="0 4 12 0 #33000000"
                                        Margin="0,0,0,10" Padding="15"
                                        BorderThickness="3,0,0,0"
                                        BorderBrush="{Binding Color}"
                                        IsHitTestVisible="True">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Icon}" FontSize="18"/>
                                            <TextBlock Text="{Binding Message}" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
