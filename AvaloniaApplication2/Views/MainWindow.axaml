<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AvaloniaApplication2.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="AvaloniaApplication2.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="750"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- 主内容区 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 - 使用标准 StackPanel + Button -->
            <Border Grid.Column="0" Width="220" 
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- 导航按钮区域 -->
                    <StackPanel DockPanel.Dock="Top" VerticalAlignment="Top" Spacing="4" Margin="8">
                        <!-- 仪表盘 -->
                        <Button Content="🏠 仪表盘" 
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding NavigateToDashboardCommand}" 
                                IsVisible="{Binding !IsShowingPluginView}"
                                Classes="NavigationButton"/>

                        <!-- 返回按钮（仅在显示插件视图时显示） -->
                        <Button Content="← 返回主页" 
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding NavigateBackToDashboardCommand}" 
                                IsVisible="{Binding IsShowingPluginView}"
                                Classes="NavigationButton"/>

                        <!-- 插件管理 -->
                        <Button Content="📦 插件管理" 
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding NavigateToPluginManagerCommand}"
                                IsVisible="{Binding !IsShowingPluginView}"
                                Classes="NavigationButton"/>

                        <!-- 设置 -->
                        <Button Content="⚙️ 设置" 
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding NavigateToSettingsCommand}"
                                IsVisible="{Binding !IsShowingPluginView}"
                                Classes="NavigationButton"/>
                    </StackPanel>
                    
                    <!-- 中间：可拖拽分隔线 -->
                    <GridSplitter Height="4" 
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Bottom"
                                  ShowsPreview="True"
                                  DockPanel.Dock="Bottom"
                                  IsVisible="{Binding RunningPlugins.Count, Converter={StaticResource IntToBoolConverter}}"/>
                    
                    <!-- 下方：插件列表 -->
                    <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto" MinHeight="50"
                                  IsVisible="{Binding RunningPlugins.Count, Converter={StaticResource IntToBoolConverter}}">
                        <ItemsControl ItemsSource="{Binding RunningPlugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name, StringFormat='🔌 {0}'}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding $parent[Window].DataContext.NavigateToPluginCommand}"
                                            CommandParameter="{Binding Id}"
                                            Classes="NavigationButton"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 主内容区域 -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentPage}"/>
                
                <!-- Toast 通知区域 - 暂时使用标准 Panel，后续可集成 SukiUI Toast -->
                <!-- TODO: 集成 SukiUI ToastHost -->
            </Grid>
        </Grid>
    </Grid>
</Window>