<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:AvaloniaApplication2.Core"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="AvaloniaApplication2.Views.PluginMarketplaceView">

    <UserControl.Styles>
        <!-- 搜索框 -->
        <Style Selector="Border.market-search">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Width" Value="360"/>
        </Style>
        <Style Selector="Border.market-search:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- 排序下拉 -->
        <Style Selector="ComboBox.market-sort">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinWidth" Value="130"/>
        </Style>

        <!-- 插件卡片 -->
        <Style Selector="Border.plugin-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="MinHeight" Value="180"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.plugin-card:pointerover">
            <Setter Property="BoxShadow" Value="0 6 20 0 #1A000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- 安装按钮 -->
        <Style Selector="Button.install-btn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.install-btn:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.install-btn.installed">
            <Setter Property="Background" Value="#107C10"/>
        </Style>
        <Style Selector="Button.install-btn:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="30,24" Spacing="20">

            <!-- ===== 顶部控制区 ===== -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="10" Padding="20,18"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="12">

                    <!-- 搜索 + 排序行 -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                        <!-- 搜索栏 -->
                        <Border Grid.Column="0" Classes="market-search" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="{x:Static core:FluentIcons.Search}"
                                           FontFamily="Segoe Fluent Icons" FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchQuery}"
                                         Watermark="搜索社区插件..."
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="13"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 排序下拉 -->
                        <ComboBox Grid.Column="1" Classes="market-sort"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedIndex="{Binding SortOptionIndex}"
                                  VerticalAlignment="Center"/>

                        <!-- 刷新按钮 -->
                        <Button Grid.Column="3"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="10,8" VerticalAlignment="Center"
                                Command="{Binding RefreshCommand}"
                                ToolTip.Tip="刷新插件市场">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Static core:FluentIcons.Refresh}"
                                           FontFamily="Segoe Fluent Icons" FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="刷新" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 筛选 + 状态行 -->
                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                    VerticalAlignment="Center">
                            <ToggleSwitch IsChecked="{Binding ShowInstalledOnly}"/>
                            <TextBlock Text="仅显示已安装" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 加载状态 ===== -->
            <Border IsVisible="{Binding IsLoading}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="10" Padding="60">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <TextBlock Text="{x:Static core:FluentIcons.Refresh}"
                               FontFamily="Segoe Fluent Icons" FontSize="32"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="正在加载插件市场..." FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ===== 插件卡片网格 ===== -->
            <WrapPanel IsVisible="{Binding !IsLoading}"
                       HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding FilteredPlugins}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="plugin-card" Margin="0,0,14,14">
                                <StackPanel Spacing="10">
                                    <!-- 图标 + 名称 + 作者 -->
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Icon}" FontSize="28"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="150">
                                                    <Run Text="作者："/>
                                                    <Run Text="{Binding Author}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 更新时间 + 版本 -->
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding UpdatedDisplay}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="v"/>
                                            <Run Text="{Binding Version}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 标签 -->
                                    <WrapPanel IsVisible="{Binding Tags.Length, Converter={StaticResource IntToBoolConverter}}">
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BorderBrush}"
                                                            CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>

                                    <!-- 描述 -->
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" MaxHeight="36"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- 操作按钮 -->
                                    <Button Content="{Binding InstallStatus}"
                                            Command="{Binding $parent[ItemsControl].DataContext.InstallPluginCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding !IsInstalling}"
                                            HorizontalAlignment="Stretch">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="CornerRadius" Value="6"/>
                                                <Setter Property="Padding" Value="12,6"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>

            <!-- ===== 空状态 ===== -->
            <Border IsVisible="{Binding FilteredPlugins.Count, Converter={StaticResource InvertBoolConverter}}"
                    Padding="60">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <TextBlock Text="{x:Static core:FluentIcons.DragDrop}"
                               FontFamily="Segoe Fluent Icons" FontSize="48"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="未找到匹配的插件" FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
