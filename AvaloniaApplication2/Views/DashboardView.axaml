<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AvaloniaApplication2.Views.DashboardView">
    
    <ScrollViewer Padding="30">
        <StackPanel Spacing="20">
            
            <!-- 欢迎标题 -->
            <StackPanel Spacing="5">
                <TextBlock Text="欢迎使用效率工坊" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="{Binding RecentActivity}" FontSize="14" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>

            <!-- 统计卡片 - 使用 Border 模拟卡片效果 -->
            <Grid ColumnDefinitions="*,*,*">
                <Grid.ColumnSpacing>15</Grid.ColumnSpacing>
                
                <!-- 总插件数 -->
                <Border Grid.Column="0" Classes="Card" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📦" FontSize="32"/>
                        <TextBlock Text="已安装插件" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="{Binding TotalPlugins}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColor}"/>
                    </StackPanel>
                </Border>

                <!-- 运行中插件 -->
                <Border Grid.Column="1" Classes="Card" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="▶️" FontSize="32"/>
                        <TextBlock Text="运行中" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="{Binding LoadedPlugins}" FontSize="32" FontWeight="Bold" Foreground="#107C10"/>
                    </StackPanel>
                </Border>

                <!-- 已启用插件 -->
                <Border Grid.Column="2" Classes="Card" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="✓" FontSize="32"/>
                        <TextBlock Text="已启用" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="{Binding EnabledPlugins}" FontSize="32" FontWeight="Bold" Foreground="#FFB900"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 快速操作 - 使用 Border 模拟卡片 -->
            <Border Classes="Card" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="快速操作" FontSize="18" FontWeight="SemiBold"/>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <Button Grid.Column="0" Height="45" Classes="SuggestedAction"
                                Command="{Binding $parent[UserControl].DataContext.NavigateToPluginManagerCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <TextBlock Text="📦" FontSize="16"/>
                                <TextBlock Text="管理插件"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Height="45"
                                Command="{Binding $parent[UserControl].DataContext.NavigateToSettingsCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <TextBlock Text="⚙️" FontSize="16"/>
                                <TextBlock Text="系统设置"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 提示信息 - 使用标准 Border -->
            <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">
                <StackPanel Spacing="5">
                    <TextBlock Text="💡 提示" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="拖拽 DLL 文件到窗口任意位置即可快速加载插件" 
                               FontSize="13" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>