<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaApplication2.ViewModels"
             xmlns:conv="clr-namespace:AvaloniaApplication2.Converters"
             xmlns:core="clr-namespace:AvaloniaApplication2.Core"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AvaloniaApplication2.Views.DashboardView">

    <UserControl.Resources>
        <conv:BoolToStrikethroughConverter x:Key="StrikethroughConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #0A000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.card:pointerover">
            <Setter Property="BoxShadow" Value="0 6 16 0 #1A000000"/>
        </Style>

        <Style Selector="TextBlock.card-header-icon">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.card-header-text">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="ComboBox.city-selector">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="Border.progress-bar">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Border.progress-fill">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Border.progress-fill.warning">
            <Setter Property="Background" Value="#D83B01"/>
        </Style>

        <Style Selector="TextBlock.todo-completed">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style Selector="Border.clickable">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.clickable:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <Style Selector="Border.quick-app-item">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.quick-app-item:pointerover">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <Style Selector="Border.delete-btn">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.delete-btn:pointerover">
            <Setter Property="Background" Value="#33FF0000"/>
        </Style>
        <Style Selector="Border.quick-app-item:pointerover Border.delete-btn">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="32">
        <StackPanel Spacing="24">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="{Binding Greeting, StringFormat='{}{0}，开发者'}"
                               FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding RecentActivity}"
                               FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button IsVisible="{Binding IsEditingLayout}"
                            Padding="10,6"
                            Background="Transparent" Foreground="#D83B01"
                            CornerRadius="6" BorderBrush="#D83B01" BorderThickness="1"
                            Cursor="Hand"
                            Command="{Binding ResetLayoutCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Static core:FluentIcons.Refresh}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                            <TextBlock Text="重置布局"/>
                        </StackPanel>
                    </Button>
                    <Button Background="Transparent" BorderThickness="0"
                            Cursor="Hand" VerticalAlignment="Center"
                            Command="{Binding ToggleLayoutEditCommand}">
                        <TextBlock Text="{x:Static core:FluentIcons.Settings}" FontFamily="Segoe Fluent Icons" FontSize="18"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="8" IsVisible="{Binding IsEditingLayout}" Margin="0,0,0,12">
                <TextBlock Text="已隐藏的卡片：" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <WrapPanel>
                    <Button Margin="4" IsVisible="{Binding ShowWeatherCard, Converter={StaticResource InvertBoolConverter}}"
                            Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="Weather">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Static core:FluentIcons.Weather}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                            <TextBlock Text="天气"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="4" IsVisible="{Binding ShowQuickAppsCard, Converter={StaticResource InvertBoolConverter}}"
                            Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="QuickApps">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Static core:FluentIcons.Lightning}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                            <TextBlock Text="快捷应用"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="4" IsVisible="{Binding ShowSystemMonitorCard, Converter={StaticResource InvertBoolConverter}}"
                            Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="SystemMonitor">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Static core:FluentIcons.Computer}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                            <TextBlock Text="系统监控"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="4" IsVisible="{Binding ShowTodoCard, Converter={StaticResource InvertBoolConverter}}"
                            Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="Todo">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Static core:FluentIcons.Todo}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                            <TextBlock Text="待办事项"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="4" IsVisible="{Binding ShowClipboardCard, Converter={StaticResource InvertBoolConverter}}"
                            Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="Clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Static core:FluentIcons.Clipboard}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                            <TextBlock Text="剪贴板"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="4" IsVisible="{Binding ShowPluginStatsCard, Converter={StaticResource InvertBoolConverter}}"
                            Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="PluginStats">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Static core:FluentIcons.Plugins}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                            <TextBlock Text="插件统计"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <Grid ColumnDefinitions="1.3*,2*,1.3*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">

                <!-- 时间与天气卡片 -->
                <Border Grid.Row="0" Grid.Column="0" Classes="card" IsVisible="{Binding ShowWeatherCard}">
                    <Grid>
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding WeatherIcon}" FontSize="18" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Cities}"
                                          SelectedItem="{Binding SelectedCity}"
                                          Classes="city-selector"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding WeatherTemperature}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding CurrentTime}" FontSize="36" FontWeight="Light" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CurrentDate}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="Weather"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- 快捷应用卡片 -->
                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Classes="card" IsVisible="{Binding ShowQuickAppsCard}">
                    <Grid>
                        <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Static core:FluentIcons.Lightning}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="快捷应用" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding ToggleAddQuickAppCommand}">
                                <TextBlock Text="{x:Static core:FluentIcons.Todo}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <StackPanel Spacing="8" IsVisible="{Binding IsAddingQuickApp}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewQuickAppText}"
                                         Watermark="输入应用名称 (如 notepad)..."
                                         FontSize="13"
                                         Padding="8,6"/>
                                <Button Grid.Column="1"
                                        Command="{Binding AddQuickAppCommand}"
                                        FontSize="13"
                                        Padding="12,6">
                                    <TextBlock Text="添加"/>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding SelectQuickAppExeCommand}"
                                        FontSize="13"
                                        Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Static core:FluentIcons.Folder}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                        <TextBlock Text="选择程序"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding QuickApps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Margin="0,6,0,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="quick-app-item" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"
                                            Tapped="OnQuickAppTapped">
                                        <Grid>
                                            <Border Classes="delete-btn"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="4,-4,-4,4"
                                                    ZIndex="10"
                                                    Background="#44FF0000">
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveQuickAppCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{x:Static core:FluentIcons.Close}" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Border>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center"
                                                           IsVisible="{Binding Icon, Converter={StaticResource IsPngPathConverter}, ConverterParameter=invert}"/>
                                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                                       IsVisible="{Binding Icon, Converter={StaticResource IsPngPathConverter}}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="QuickApps"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- 系统监控卡片 -->
                <Border Grid.Row="0" Grid.Column="2" Classes="card" IsVisible="{Binding ShowSystemMonitorCard}">
                    <Grid>
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Static core:FluentIcons.Computer}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="系统监控" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                                <!-- CPU 竖条 -->
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding CpuUsage, StringFormat='{}{0}%'}"
                                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <!-- 轨 + 填充 -->
                                    <Border Width="22" Height="72" CornerRadius="11"
                                            Background="{DynamicResource BorderBrush}">
                                        <Border Width="22" CornerRadius="11"
                                                Height="{Binding CpuFillHeight}"
                                                VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding CpuColor}"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="CPU" FontSize="10" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <!-- 内存 竖条 -->
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding MemoryUsage, StringFormat='{}{0}%'}"
                                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border Width="22" Height="72" CornerRadius="11"
                                            Background="{DynamicResource BorderBrush}">
                                        <Border Width="22" CornerRadius="11"
                                                Height="{Binding MemFillHeight}"
                                                VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding MemColor}"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="内存" FontSize="10" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="SystemMonitor"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- 待办事项卡片 -->
                <Border Grid.Row="1" Grid.Column="0" Classes="card" IsVisible="{Binding ShowTodoCard}">
                    <Grid>
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Static core:FluentIcons.Todo}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="待办事项" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewTodoText}"
                                     Watermark="输入新的待办事项..."
                                     FontSize="13"
                                     Padding="8,6"/>
                            <Button Grid.Column="1"
                                    Command="{Binding AddTodoItemCommand}"
                                    FontSize="13"
                                    Padding="12,6">
                                <TextBlock Text="添加"/>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TodoItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" Margin="0,4,0,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsCompleted}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="14"
                                                   TextDecorations="{Binding IsCompleted, Converter={StaticResource StrikethroughConverter}}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,0"
                                                Cursor="Hand"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveTodoItemCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{x:Static core:FluentIcons.Delete}" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="Todo"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- 剪贴板历史卡片 -->
                <Border Grid.Row="1" Grid.Column="2" Classes="card" IsVisible="{Binding ShowClipboardCard}">
                    <Grid>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Static core:FluentIcons.Clipboard}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="剪贴板历史" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 最近5条 -->
                        <ItemsControl ItemsSource="{Binding ClipboardHistory}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BorderBrush}"
                                            CornerRadius="4" Padding="6,5"
                                            Cursor="Hand" Tapped="OnClipboardItemTapped"
                                            Height="30">
                                        <TextBlock Text="{Binding Content}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 查看更多按钮 -->
                        <Button Background="Transparent" BorderThickness="0"
                                Padding="2" HorizontalAlignment="Center" Cursor="Hand"
                                Command="{Binding ToggleClipboardCommand}"
                                IsVisible="{Binding ClipboardHistory.Count, Converter={StaticResource IntToBoolConverter}}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}">
                                <Run Text="查看更多 ("/>
                                <Run Text="{Binding ClipboardHistory.Count}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>

                    <!-- 浮层：展开的完整历史 -->
                    <Border IsVisible="{Binding ClipboardExpanded}"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            BoxShadow="0 8 32 0 #66000000"
                            Width="280" MaxHeight="320"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,6,0,0" ZIndex="900">
                        <Grid RowDefinitions="*,Auto">
                            <ScrollViewer Grid.Row="0" Margin="4">
                                <ItemsControl ItemsSource="{Binding ClipboardHistory}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BorderBrush}"
                                                    CornerRadius="4" Padding="8,6"
                                                    Cursor="Hand"
                                                    Tapped="OnClipboardItemTapped">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding Content}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Opacity="0.6" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Row="1" Content="收起" Padding="8,4"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding ToggleClipboardCommand}"
                                    FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </Border>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="Clipboard"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- 插件统计卡片 -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Classes="card" IsVisible="{Binding ShowPluginStatsCard}">
                    <Grid>
                    <Grid ColumnDefinitions="1.3*,2*,1.3*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Static core:FluentIcons.Plugins}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="插件总数" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalPlugins}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Static core:FluentIcons.CheckmarkCircle}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#107C10"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="已加载" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding LoadedPlugins}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Static core:FluentIcons.Lightning}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="已启用" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding EnabledPlugins}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="PluginStats"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
