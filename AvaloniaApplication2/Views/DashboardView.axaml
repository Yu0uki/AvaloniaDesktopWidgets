<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaApplication2.ViewModels"
             xmlns:conv="clr-namespace:AvaloniaApplication2.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AvaloniaApplication2.Views.DashboardView">

    <UserControl.Resources>
        <conv:BoolToStrikethroughConverter x:Key="StrikethroughConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 卡片样式 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #0A000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.card:pointerover">
            <Setter Property="BoxShadow" Value="0 6 16 0 #1A000000"/>
        </Style>

        <!-- 卡片标题图标 + 文字 (匹配原型设计语言) -->
        <Style Selector="TextBlock.card-header-icon">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.card-header-text">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 城市选择 ComboBox (匹配原型 select 样式) -->
        <Style Selector="ComboBox.city-selector">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- 进度条样式 -->
        <Style Selector="Border.progress-bar">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style Selector="Border.progress-fill">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style Selector="Border.progress-fill.warning">
            <Setter Property="Background" Value="#D83B01"/>
        </Style>

        <!-- 待办事项完成样式 -->
        <Style Selector="TextBlock.todo-completed">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <!-- 可点击项目 -->
        <Style Selector="Border.clickable">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.clickable:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <!-- 快捷应用项 -->
        <Style Selector="Border.quick-app-item">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.quick-app-item:pointerover">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <!-- 删除按钮 -->
        <Style Selector="Border.delete-btn">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.delete-btn:pointerover">
            <Setter Property="Background" Value="#33FF0000"/>
        </Style>
        <Style Selector="Border.quick-app-item:pointerover Border.delete-btn">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="32">
        <StackPanel Spacing="24">

            <!-- 问候语和副标题 -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="{Binding Greeting, StringFormat='{}{0}，开发者'}"
                               FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding RecentActivity}"
                               FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 重置布局按钮（编辑模式可见） -->
                    <Button IsVisible="{Binding IsEditingLayout}"
                            Content="↺ 重置布局" Padding="10,6"
                            Background="Transparent" Foreground="#D83B01"
                            CornerRadius="6" BorderBrush="#D83B01" BorderThickness="1"
                            Cursor="Hand"
                            Command="{Binding ResetLayoutCommand}"/>
                    <!-- 布局编辑开关 -->
                    <Button Background="Transparent" BorderThickness="0"
                            Cursor="Hand" VerticalAlignment="Center"
                            Command="{Binding ToggleLayoutEditCommand}">
                        <TextBlock Text="🔧" FontSize="18"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 编辑模式：已隐藏卡片恢复面板 -->
            <StackPanel Spacing="8" IsVisible="{Binding IsEditingLayout}" Margin="0,0,0,12">
                <TextBlock Text="已隐藏的卡片：" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <WrapPanel>
                    <Button Margin="4" IsVisible="{Binding ShowWeatherCard, Converter={StaticResource InvertBoolConverter}}"
                            Content="🌤 天气" Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="Weather"/>
                    <Button Margin="4" IsVisible="{Binding ShowQuickAppsCard, Converter={StaticResource InvertBoolConverter}}"
                            Content="⚡ 快捷应用" Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="QuickApps"/>
                    <Button Margin="4" IsVisible="{Binding ShowSystemMonitorCard, Converter={StaticResource InvertBoolConverter}}"
                            Content="⚙️ 系统监控" Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="SystemMonitor"/>
                    <Button Margin="4" IsVisible="{Binding ShowTodoCard, Converter={StaticResource InvertBoolConverter}}"
                            Content="✓ 待办事项" Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="Todo"/>
                    <Button Margin="4" IsVisible="{Binding ShowClipboardCard, Converter={StaticResource InvertBoolConverter}}"
                            Content="📋 剪贴板" Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="Clipboard"/>
                    <Button Margin="4" IsVisible="{Binding ShowPluginStatsCard, Converter={StaticResource InvertBoolConverter}}"
                            Content="📦 插件统计" Padding="8,4" CornerRadius="4"
                            Command="{Binding ToggleCardCommand}" CommandParameter="PluginStats"/>
                </WrapPanel>
            </StackPanel>

            <!-- 仪表盘卡片网格 -->
            <Grid ColumnDefinitions="*,2*,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto" RowSpacing="20">

                <!-- ========== 时间与天气卡片 ========== -->
                <Border Grid.Row="0" Grid.Column="0" Classes="card" IsVisible="{Binding ShowWeatherCard}">
                    <Grid>
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding WeatherIcon}" FontSize="18" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Cities}"
                                          SelectedItem="{Binding SelectedCity}"
                                          Classes="city-selector"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding WeatherTemperature}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding CurrentTime}" FontSize="36" FontWeight="Light" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CurrentDate}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="Weather"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========== 快捷应用卡片 ========== -->
                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Classes="card" IsVisible="{Binding ShowQuickAppsCard}">
                    <Grid>
                        <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚡" FontSize="18"/>
                                <TextBlock Text="快捷应用" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding ToggleAddQuickAppCommand}">
                                <TextBlock Text="✏️" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- 添加快捷应用输入框 -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsAddingQuickApp}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewQuickAppText}"
                                         Watermark="输入应用名称 (如 notepad)..."
                                         FontSize="13"
                                         Padding="8,6"/>
                                <Button Grid.Column="1"
                                        Command="{Binding AddQuickAppCommand}"
                                        FontSize="13"
                                        Padding="12,6">
                                    <TextBlock Text="添加"/>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding SelectQuickAppExeCommand}"
                                        FontSize="13"
                                        Padding="12,6">
                                    <TextBlock Text="📂 选择程序"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 快捷应用列表 -->
                        <ItemsControl ItemsSource="{Binding QuickApps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Margin="0,6,0,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="quick-app-item" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"
                                            Tapped="OnQuickAppTapped">
                                        <Grid>
                                            <!-- 删除按钮 -->
                                            <Border Classes="delete-btn"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="4,-4,-4,4"
                                                    ZIndex="10"
                                                    Background="#44FF0000">
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveQuickAppCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="✕" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Border>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                <!-- Emoji 图标 -->
                                                <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center"
                                                           IsVisible="{Binding Icon, Converter={StaticResource IsPngPathConverter}, ConverterParameter=invert}"/>
                                                <!-- 提取的 PNG 图标 -->
                                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                                       IsVisible="{Binding Icon, Converter={StaticResource IsPngPathConverter}}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="QuickApps"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========== 系统监控卡片 ========== -->
                <Border Grid.Row="0" Grid.Column="2" Classes="card" IsVisible="{Binding ShowSystemMonitorCard}">
                    <Grid>
                        <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚙️" FontSize="18"/>
                            <TextBlock Text="系统监控" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="CPU 占用" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuUsage, StringFormat='{}{0}%'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Border Classes="progress-bar" ClipToBounds="True">
                                    <Border Classes="progress-fill" HorizontalAlignment="Left" Width="{Binding CpuUsage}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="内存占用" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MemoryUsage, StringFormat='{}{0}%'}" FontSize="12" Foreground="#D83B01"/>
                                </Grid>
                                <Border Classes="progress-bar" ClipToBounds="True">
                                    <Border Classes="progress-fill warning" HorizontalAlignment="Left" Width="{Binding MemoryUsage}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="SystemMonitor"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========== 待办事项卡片 ========== -->
                <Border Grid.Row="1" Grid.Column="0" Classes="card" IsVisible="{Binding ShowTodoCard}">
                    <Grid>
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="✓" FontSize="18"/>
                                <TextBlock Text="待办事项" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- 添加新待办 -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewTodoText}"
                                     Watermark="输入新的待办事项..."
                                     FontSize="13"
                                     Padding="8,6"/>
                            <Button Grid.Column="1"
                                    Command="{Binding AddTodoItemCommand}"
                                    FontSize="13"
                                    Padding="12,6">
                                <TextBlock Text="添加"/>
                            </Button>
                        </Grid>

                        <!-- 待办事项列表 -->
                        <ItemsControl ItemsSource="{Binding TodoItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" Margin="0,4,0,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsCompleted}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="14"
                                                   TextDecorations="{Binding IsCompleted, Converter={StaticResource StrikethroughConverter}}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,0"
                                                Cursor="Hand"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveTodoItemCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="🗑️" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="Todo"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========== 剪贴板历史卡片 ========== -->
                <Border Grid.Row="1" Grid.Column="2" Classes="card" IsVisible="{Binding ShowClipboardCard}">
                    <Grid>
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📋" FontSize="18"/>
                            <TextBlock Text="剪贴板历史" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ClipboardHistory}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" Margin="0,4,0,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BorderBrush}"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            Cursor="Hand"
                                            Tapped="OnClipboardItemTapped">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Content}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TimeDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="Clipboard"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========== 插件统计卡片 ========== -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Classes="card" IsVisible="{Binding ShowPluginStatsCard}">
                    <Grid>
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="18"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="插件总数" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalPlugins}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="✅" FontSize="18"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="已加载" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding LoadedPlugins}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="18"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="已启用" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding EnabledPlugins}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                        <Border IsVisible="{Binding IsEditingLayout}" Background="#88FFFFFF" CornerRadius="8" ZIndex="20">
                            <Button Command="{Binding ToggleCardCommand}"
                                    CommandParameter="PluginStats"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,8">
                                <TextBlock Text="隐藏此卡片"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
