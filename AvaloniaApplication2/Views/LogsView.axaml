<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:AvaloniaApplication2.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AvaloniaApplication2.Views.LogsView">

    <UserControl.Styles>
        <Style Selector="Border.log-entry">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style Selector="Border.log-entry:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>
        <Style Selector="Border.log-badge">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="52"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="30">
        <!-- 标题栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Spacing="8">
                <TextBlock Text="运行日志" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#107C10"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Padding="12,6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        Foreground="{DynamicResource AccentBrush}"
                        CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Static core:FluentIcons.Refresh}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
                <Button Padding="12,6"
                        Background="Transparent" Foreground="#D83B01"
                        CornerRadius="6" BorderBrush="#D83B01" BorderThickness="1"
                        Command="{Binding ClearLogsCommand}">
                    <TextBlock Text="清除日志"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 日志列表 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding LogEntries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="log-entry"
                                    BorderBrush="{Binding Type, Converter={StaticResource LogTypeColorConverter}}"
                                    BorderThickness="3,0,0,0" Margin="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <!-- 类型标签 -->
                                    <Border Grid.Column="0"
                                            Background="{Binding Type, Converter={StaticResource LogTypeColorConverter}}"
                                            CornerRadius="3" Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeDisplay}" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                    <!-- 消息 -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Message}" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <!-- 时间 -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Timestamp, StringFormat='MM-dd HH:mm:ss'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <Border IsVisible="{Binding LogEntries.Count, Converter={StaticResource InvertBoolConverter}}"
                        Padding="60">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <TextBlock Text="{x:Static core:FluentIcons.Logs}"
                                   FontFamily="Segoe Fluent Icons" FontSize="48"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无日志记录" FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
