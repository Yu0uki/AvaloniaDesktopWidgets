<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:AvaloniaApplication2.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AvaloniaApplication2.Views.LogsView">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Type → icon / color mapping for log entries -->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="30">
        <!-- 标题栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Spacing="8">
                <TextBlock Text="消息日志" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#107C10"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Padding="12,6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        Foreground="{DynamicResource AccentBrush}"
                        CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Static core:FluentIcons.Refresh}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
                <Button Padding="12,6"
                        Background="Transparent" Foreground="#D83B01"
                        CornerRadius="6" BorderBrush="#D83B01" BorderThickness="1"
                        Command="{Binding ClearLogsCommand}">
                    <TextBlock Text="清除日志"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 日志列表 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding LogEntries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,12"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <!-- Type icon -->
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe Fluent Icons" FontSize="16"
                                               VerticalAlignment="Center"
                                               Width="24" Height="24"/>
                                    <!-- Message -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Message}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Timestamp, StringFormat='MM-dd HH:mm:ss'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <Border IsVisible="{Binding LogEntries.Count, Converter={StaticResource InvertBoolConverter}}"
                        Padding="60">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <TextBlock Text="{x:Static core:FluentIcons.CheckmarkCircle}"
                                   FontFamily="Segoe Fluent Icons" FontSize="48"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无日志记录" FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
