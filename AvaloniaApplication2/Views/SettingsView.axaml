<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="AvaloniaApplication2.Views.SettingsView"
             xmlns:core="clr-namespace:AvaloniaApplication2.Core">

    <UserControl.Styles>
        <!-- 设置分类标签页按钮 -->
        <Style Selector="Button.settings-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.settings-tab:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- 设置卡片 -->
        <Style Selector="Border.setting-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,20"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.setting-card:pointerover">
            <Setter Property="BoxShadow" Value="0 2 8 0 #0A000000"/>
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,48,0,16"/>
        </Style>

        <Style Selector="Border.coming-soon-badge">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style Selector="TextBlock.coming-soon-text">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888888"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- 顶部固定标签栏 -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="40,14,40,14" Spacing="24">
                <Button Content="通用设置" Classes="settings-tab" Click="OnGeneralTabClick"/>
                <Button Content="界面设置" Classes="settings-tab" Click="OnAppearanceTabClick"/>
                <Button Content="插件设置" Classes="settings-tab" Click="OnPluginTabClick"/>
                <Button Content="设置同步" Classes="settings-tab" Click="OnSyncTabClick"/>
                <Button Content="用户数据" Classes="settings-tab" Click="OnUserDataTabClick"/>
                <Button Content="高级设置" Classes="settings-tab" Click="OnAdvancedTabClick"/>
                <Button Content="关于" Classes="settings-tab" Click="OnAboutTabClick"/>
            </StackPanel>
        </Border>

        <!-- 可滚动内容区 -->
        <ScrollViewer Grid.Row="1" x:Name="SettingsScrollViewer">
            <StackPanel MaxWidth="960" HorizontalAlignment="Center" Margin="40,0,40,60" Spacing="0">

                <StackPanel Margin="0,20,0,40">
                    <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#107C10"/>
                </StackPanel>

            <!-- ===== 通用设置 ===== -->
            <TextBlock x:Name="GeneralSectionHeader" Text="通用设置" Classes="section-header"/>

            <StackPanel Spacing="8">

                <!-- 自动加载插件 -->
                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static core:FluentIcons.AutoLoad}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="启动时自动加载插件" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="应用程序启动时自动加载 Plugins 目录中的所有插件" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding AutoLoadPlugins}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 搜索历史 -->
                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static core:FluentIcons.Search}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="搜索历史记录" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="启用后，顶部搜索栏将记录搜索历史" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding EnableSearchHistory}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 插件目录 -->
                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:FluentIcons.Folder}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="插件目录" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="指定插件 DLL 文件的存放位置" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0" Text="{Binding PluginsDirectory}" Watermark="插件目录路径" FontSize="13" Padding="8,6"/>
                            <Button Grid.Column="1" Content="浏览..." Padding="15,6"
                                    Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentBrush}"
                                    CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Command="{Binding SelectFolderCommand}"/>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ===== 界面设置 ===== -->
            <TextBlock x:Name="AppearanceSectionHeader" Text="界面设置" Classes="section-header"/>

            <StackPanel Spacing="8">

                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static core:FluentIcons.Computer}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="启动时默认打开页面" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding DefaultStartupPageIndex}"
                                  Background="{DynamicResource SearchBoxBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  CornerRadius="6" Padding="12,6" MinWidth="180">
                            <ComboBoxItem Content="仪表盘 (Dashboard)"/>
                            <ComboBoxItem Content="应用库"/>
                            <ComboBoxItem Content="上次打开的页面"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static core:FluentIcons.Brightness}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="主题" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="设置程序的主题风格（深色 / 浅色 / 跟随系统）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding SelectedThemeIndex}"
                                  Background="{DynamicResource SearchBoxBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  CornerRadius="6" Padding="12,6" MinWidth="180">
                            <ComboBoxItem Content="深色 (Dark)"/>
                            <ComboBoxItem Content="浅色 (Light)"/>
                            <ComboBoxItem Content="跟随系统 (System)"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static core:FluentIcons.Palette}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="主题色" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="设置程序中显示的强调色" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding AccentColorIndex}"
                                  Background="{DynamicResource SearchBoxBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  CornerRadius="6" Padding="12,6" MinWidth="180">
                            <ComboBoxItem Content="默认蓝"/>
                            <ComboBoxItem Content="翠绿"/>
                            <ComboBoxItem Content="紫色"/>
                            <ComboBoxItem Content="橙色"/>
                            <ComboBoxItem Content="红色"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static core:FluentIcons.Language}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="语言" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="设置程序首选的显示语言" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding LanguageIndex}"
                                  Background="{DynamicResource SearchBoxBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  CornerRadius="6" Padding="12,6" MinWidth="180">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="简体中文"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static core:FluentIcons.Brightness}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="背景不透明度" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding BackgroundOpacity, StringFormat='当前值: {0:F0}%'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Slider Grid.Column="2" Minimum="30" Maximum="100" Value="{Binding BackgroundOpacity}"
                                Width="200" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:FluentIcons.Image}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="自定义背景图片" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="使用自定义图片作为窗口背景" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Row="0" Grid.Column="2" IsChecked="{Binding CustomBackgroundImage}" VerticalAlignment="Center"/>
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                              ColumnDefinitions="*,Auto" ColumnSpacing="10"
                              IsVisible="{Binding CustomBackgroundImage}">
                            <TextBox Grid.Column="0" Text="{Binding BackgroundImagePath}"
                                     Watermark="选择背景图片..." FontSize="13" Padding="8,6" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="选择图片..." Padding="15,6"
                                    Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentBrush}"
                                    CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Command="{Binding SelectBackgroundImageCommand}"/>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ===== 插件设置 ===== -->
            <TextBlock x:Name="PluginSectionHeader" Text="插件设置" Classes="section-header"/>

            <StackPanel Spacing="8">

                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static core:FluentIcons.Security}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="插件安全检测" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Classes="coming-soon-badge" VerticalAlignment="Center">
                                    <TextBlock Text="即将推出" Classes="coming-soon-text"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="加载插件前进行安全扫描" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static core:FluentIcons.AutoUpdate}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="自动更新插件" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Classes="coming-soon-badge" VerticalAlignment="Center">
                                    <TextBlock Text="即将推出" Classes="coming-soon-text"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="有可用更新时自动下载安装" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 插件市场地址 -->
                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:FluentIcons.Marketplace}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="插件市场地址" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="GitHub 插件市场索引文件的 Raw URL" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                 Text="{Binding PluginMarketUrl}"
                                 Watermark="https://raw.githubusercontent.com/.../index.json"
                                 FontSize="13" Padding="8,6"/>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ===== 设置同步 ===== -->
            <TextBlock x:Name="SyncSectionHeader" Text="设置同步" Classes="section-header"/>

            <StackPanel Spacing="8">

                <!-- 启用同步 + 自动同步 -->
                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:FluentIcons.AutoUpdate}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="启用设置同步" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="将设置文件同步到您的 GitHub 私有仓库" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Row="0" Grid.Column="2" IsChecked="{Binding SyncEnabled}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch IsChecked="{Binding AutoSync}" IsEnabled="{Binding SyncEnabled}"/>
                            <TextBlock Text="保存设置时自动同步" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 仓库配置 -->
                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:FluentIcons.Marketplace}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="GitHub 仓库配置" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="配置目标仓库和访问令牌（支持私有仓库）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Owner / Repo -->
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <TextBox Grid.Column="0" Text="{Binding SyncRepoOwner}"
                                     Watermark="GitHub 用户名 (Owner)" FontSize="13" Padding="8,6"/>
                            <TextBox Grid.Column="1" Text="{Binding SyncRepoName}"
                                     Watermark="仓库名 (Repo)" FontSize="13" Padding="8,6"/>
                        </Grid>

                        <!-- Token -->
                        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                 Text="{Binding SyncToken}" PasswordChar="•"
                                 Watermark="GitHub Personal Access Token (需 repo 权限)"
                                 FontSize="13" Padding="8,6"/>

                        <!-- Branch -->
                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                 Text="{Binding SyncBranch}"
                                 Watermark="分支名 (默认 main)" FontSize="13" Padding="8,6"/>
                    </Grid>
                </Border>

                <!-- 操作按钮 + 状态 -->
                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="上次同步: "/>
                                <Run Text="{Binding LastSyncTime, TargetNullValue='从未同步'}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                Command="{Binding SaveSyncSettingsCommand}">
                            <TextBlock Text="保存配置"/>
                        </Button>
                        <Button Grid.Column="2" Padding="12,6"
                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                CornerRadius="6" BorderThickness="0"
                                Command="{Binding SyncNowCommand}"
                                IsEnabled="{Binding SyncEnabled}">
                            <TextBlock Text="立即同步"/>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ===== 用户数据 ===== -->
            <TextBlock x:Name="UserDataSectionHeader" Text="用户数据" Classes="section-header"/>

            <StackPanel Spacing="8">

                <Border Classes="setting-card">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Padding="12,6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Command="{Binding RefreshUserDataCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Static core:FluentIcons.Refresh}" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                    <TextBlock Text="刷新列表"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" MaxHeight="400">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding UserDataFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,10" Margin="0,0,0,4"
                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                        <!-- 类型标签 -->
                                                        <Border Grid.Column="0"
                                                                Background="{DynamicResource BorderBrush}"
                                                                CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <!-- 文件名 + 路径 -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding FilePath}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <!-- 大小 + 时间 -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="10,0">
                                                            <TextBlock Text="{Binding SizeDisplay}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding LastModified, StringFormat='MM-dd HH:mm'}" FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <!-- 操作按钮 -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Button Padding="8,4" FontSize="11"
                                                                    Background="Transparent"
                                                                    Foreground="{DynamicResource AccentBrush}"
                                                                    CornerRadius="4"
                                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                                    Command="{Binding $parent[ItemsControl].DataContext.ViewFileContentCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="查看"/>
                                                            </Button>
                                                            <Button Padding="8,4" FontSize="11"
                                                                    Background="Transparent" Foreground="#D13438"
                                                                    CornerRadius="4"
                                                                    BorderBrush="#D13438" BorderThickness="1"
                                                                    Command="{Binding $parent[ItemsControl].DataContext.DeleteDataFileCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="删除"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- 展开的内容区 -->
                                                    <Border IsVisible="{Binding IsContentVisible}"
                                                            Background="{DynamicResource BorderBrush}"
                                                            CornerRadius="4" Padding="10">
                                                        <ScrollViewer MaxHeight="200">
                                                            <TextBlock Text="{Binding Content}" FontFamily="Consolas" FontSize="12"
                                                                       TextWrapping="Wrap"/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 空状态 -->
                                <Border Padding="40">
                                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                                        <TextBlock Text="{x:Static core:FluentIcons.Folder}"
                                                   FontFamily="Segoe Fluent Icons" FontSize="32"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="点击「刷新列表」加载数据文件" FontSize="14"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ===== 高级设置 ===== -->
            <TextBlock x:Name="AdvancedSectionHeader" Text="高级设置" Classes="section-header"/>

            <StackPanel Spacing="8">

                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static core:FluentIcons.Hardware}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="硬件加速" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Classes="coming-soon-badge" VerticalAlignment="Center">
                                    <TextBlock Text="即将推出" Classes="coming-soon-text"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="启用 GPU 硬件加速渲染" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:FluentIcons.Cache}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="清除缓存数据" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="清除所有本地缓存和临时文件" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="2" Content="清除缓存" Padding="12,6"
                                Background="Transparent" Foreground="#D83B01"
                                CornerRadius="6" BorderBrush="#D83B01" BorderThickness="1"
                                Command="{Binding ClearCacheCommand}" VerticalAlignment="Center"/>
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0" Text="{Binding CacheDirectory}" Watermark="缓存数据目录路径" FontSize="13" Padding="8,6"/>
                            <Button Grid.Column="1" Content="浏览..." Padding="15,6"
                                    Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentBrush}"
                                    CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Command="{Binding SelectCacheFolderCommand}"/>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ===== 关于 ===== -->
            <TextBlock x:Name="AboutSectionHeader" Text="关于" Classes="section-header"/>

            <StackPanel Spacing="8">

                <Border Classes="setting-card" Padding="40,48">
                    <StackPanel Spacing="24" HorizontalAlignment="Center" MaxWidth="500">

                        <!-- 层级一：应用图标 -->
                        <Border Width="80" Height="80" CornerRadius="18"
                                Background="{DynamicResource AccentBrush}"
                                BoxShadow="0 4 16 0 #33000000"
                                HorizontalAlignment="Center">
                            <Image Source="/Assets/avalonia-logo.ico"
                                   Width="48" Height="48"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>

                        <!-- 层级二：主标题 -->
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="EfficiencyWorkshop"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <!-- 层级三：版本号 -->
                            <TextBlock HorizontalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="版本 "/>
                                <Run Text="{Binding AppVersion}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- 层级四：分隔线 + 链接 -->
                        <Separator Background="{DynamicResource BorderBrush}" Width="200"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <!-- 项目主页 -->
                            <Button Background="Transparent" BorderThickness="0" Padding="4"
                                    Cursor="Hand" HorizontalAlignment="Center"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="https://github.com/Yu0uki/EfficiencyWorkshop.Plugins">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                               TextDecorations="Underline">
                                        <Run Text="EfficiencyWorkshop"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Run Text="(GitHub)"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <!-- 作者主页 -->
                            <Button Background="Transparent" BorderThickness="0" Padding="4"
                                    Cursor="Hand" HorizontalAlignment="Center"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="https://github.com/Yu0uki">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="By" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Yu0uki" FontSize="13"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextDecorations="Underline"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="基于 Avalonia UI 构建的模块化插件桌面平台"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 层级五：许可证信息 -->
                        <Border Background="{DynamicResource BorderBrush}"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="开源许可证" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" LineHeight="18">
                                    <Run Text="Avalonia UI"/>
                                    <Run Text=" — MIT License"/>
                                    <LineBreak/>
                                    <Run Text="CommunityToolkit.Mvvm"/>
                                    <Run Text=" — MIT License"/>
                                    <LineBreak/>
                                    <Run Text="Serilog"/>
                                    <Run Text=" — Apache-2.0 License"/>
                                    <LineBreak/>
                                    <Run Text="Microsoft.Extensions.DependencyInjection"/>
                                    <Run Text=" — MIT License"/>
                                    <LineBreak/>
                                    <Run Text="System.Drawing.Common"/>
                                    <Run Text=" — MIT License"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
