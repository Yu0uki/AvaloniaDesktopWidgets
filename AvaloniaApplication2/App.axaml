<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApplication2.App"
             xmlns:local="using:AvaloniaApplication2"
             xmlns:vm="using:AvaloniaApplication2.ViewModels"
             xmlns:views="using:AvaloniaApplication2.Views"
             xmlns:converters="using:AvaloniaApplication2.Converters">

    <Application.DataTemplates>
        <!-- ViewModel 到 View 的映射 -->
        <DataTemplate DataType="vm:DashboardViewModel">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="vm:PluginManagerViewModel">
            <views:PluginManagerView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView/>
        </DataTemplate>
        
        <!-- 保留 ViewLocator 作为备用 -->
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <!-- SukiUI 主题 - 暂时注释，待确认正确用法 -->
        <!-- <suki:SukiTheme ThemeColor="Blue" /> -->
        
        <!-- 临时使用 Fluent 主题 + SukiUI 样式增强 -->
        <FluentTheme />
        
        <!-- Card 样式 - 模拟 SukiCard 效果 -->
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <Style Selector="Button.NavigationButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style Selector="Button.NavigationButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
        </Style>
        
        <Style Selector="Button.NavigationButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        
        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="#D13438"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style Selector="Button.Danger:pointerover">
            <Setter Property="Background" Value="#C50F1F"/>
        </Style>
    </Application.Styles>
    
    <!-- SukiUI 全局资源 -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- 注册转换器 -->
            <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
            <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>