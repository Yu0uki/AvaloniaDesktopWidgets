<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApplication2.App"
             xmlns:local="using:AvaloniaApplication2"
             xmlns:vm="using:AvaloniaApplication2.ViewModels"
             xmlns:views="using:AvaloniaApplication2.Views"
             xmlns:converters="using:AvaloniaApplication2.Converters">

    <Application.DataTemplates>
        <!-- ViewModel 到 View 的映射 -->
        <DataTemplate DataType="vm:DashboardViewModel">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="vm:PluginManagerViewModel">
            <views:PluginManagerView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:LogsViewModel">
            <views:LogsView/>
        </DataTemplate>

        <!-- 保留 ViewLocator 作为备用 -->
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- 全局过渡动画：主题切换 0.3s ease -->
        <Style Selector="Window">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3" Easing="SineEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3" Easing="SineEaseInOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3" Easing="SineEaseInOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" Easing="SineEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.3" Easing="SineEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
    </Application.Styles>

    <!-- 全局主题样式 -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- 注册转换器 -->
            <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
            <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
            <converters:IsPngPathConverter x:Key="IsPngPathConverter"/>
            <converters:PluginStatusBorderBrushConverter x:Key="PluginStatusBorderBrushConverter"/>
            <converters:PluginIconConverter x:Key="PluginIconConverter"/>

            <!-- 运行时可变资源 -->
            <SolidColorBrush x:Key="TopBarAccentBorderBrush" Color="#E0E0E0"/>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="WindowBackgroundColor">#1E1E1E</Color>
                    <Color x:Key="CardBackgroundColor">#2D2D2D</Color>
                    <Color x:Key="TopBarBackgroundColor">#2D2D2D</Color>
                    <Color x:Key="SidebarBackgroundColor">#252526</Color>
                    <Color x:Key="SearchBoxBackgroundColor">#383838</Color>
                    <Color x:Key="SearchBoxFocusBackgroundColor">#404040</Color>
                    <Color x:Key="ShortcutKeyBackgroundColor">#383838</Color>
                    <Color x:Key="NavHoverColor">#383838</Color>
                    <Color x:Key="NavActiveColor">#37373D</Color>
                    <Color x:Key="WindowControlHoverColor">#383838</Color>
                    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
                    <Color x:Key="TextSecondaryColor">#B0B0B0</Color>
                    <Color x:Key="BorderColor">#3F3F3F</Color>
                    <Color x:Key="AccentColor">#4FC3F7</Color>
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardBackgroundColor}"/>
                    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="{DynamicResource TopBarBackgroundColor}"/>
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource SidebarBackgroundColor}"/>
                    <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="{DynamicResource SearchBoxBackgroundColor}"/>
                    <SolidColorBrush x:Key="SearchBoxFocusBackgroundBrush" Color="{DynamicResource SearchBoxFocusBackgroundColor}"/>
                    <SolidColorBrush x:Key="ShortcutKeyBackgroundBrush" Color="{DynamicResource ShortcutKeyBackgroundColor}"/>
                    <SolidColorBrush x:Key="NavHoverBrush" Color="{DynamicResource NavHoverColor}"/>
                    <SolidColorBrush x:Key="NavActiveBrush" Color="{DynamicResource NavActiveColor}"/>
                    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="{DynamicResource WindowControlHoverColor}"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Windows 11 浅色主题 -->
                    <Color x:Key="WindowBackgroundColor">#F3F3F3</Color>
                    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
                    <Color x:Key="TopBarBackgroundColor">#F8F8F8</Color>
                    <Color x:Key="SidebarBackgroundColor">#F3F3F3</Color>
                    <Color x:Key="SearchBoxBackgroundColor">#FFFFFF</Color>
                    <Color x:Key="SearchBoxFocusBackgroundColor">#FFFFFF</Color>
                    <Color x:Key="ShortcutKeyBackgroundColor">#F0F0F0</Color>
                    <Color x:Key="NavHoverColor">#F0F0F0</Color>
                    <Color x:Key="NavActiveColor">#E3F2FD</Color>
                    <Color x:Key="WindowControlHoverColor">#F0F0F0</Color>
                    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
                    <Color x:Key="TextSecondaryColor">#5E5E5E</Color>
                    <Color x:Key="BorderColor">#E0E0E0</Color>
                    <Color x:Key="AccentColor">#0067C0</Color>
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardBackgroundColor}"/>
                    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="{DynamicResource TopBarBackgroundColor}"/>
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource SidebarBackgroundColor}"/>
                    <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="{DynamicResource SearchBoxBackgroundColor}"/>
                    <SolidColorBrush x:Key="SearchBoxFocusBackgroundBrush" Color="{DynamicResource SearchBoxFocusBackgroundColor}"/>
                    <SolidColorBrush x:Key="ShortcutKeyBackgroundBrush" Color="{DynamicResource ShortcutKeyBackgroundColor}"/>
                    <SolidColorBrush x:Key="NavHoverBrush" Color="{DynamicResource NavHoverColor}"/>
                    <SolidColorBrush x:Key="NavActiveBrush" Color="{DynamicResource NavActiveColor}"/>
                    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="{DynamicResource WindowControlHoverColor}"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
