<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JsonToolboxPlugin.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="JsonToolboxPlugin.MainView"
             x:DataType="vm:MainViewModel">

  <Design.DataContext>
    <vm:MainViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <!-- ===== 顶部工具栏 ===== -->
    <Border Grid.Row="0" Padding="10,8"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- 左侧: 标题 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="🗜️" FontSize="18"/>
          <TextBlock Text="JSON 工具箱" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 中间: 操作按钮 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
          <Button Content="✨ 格式化" Command="{Binding FormatJsonCommand}"
                  MinWidth="80" Height="32" FontSize="12"/>
          <Button Content="📦 压缩" Command="{Binding MinifyJsonCommand}"
                  MinWidth="70" Height="32" FontSize="12"/>
          <Button Content="✔️ 验证" Command="{Binding ValidateJsonCommand}"
                  MinWidth="70" Height="32" FontSize="12"/>
          <Separator Width="1" Height="20" VerticalAlignment="Center" Margin="4,0"/>

          <Button Content="➡️ 转义" Command="{Binding EscapeJsonCommand}"
                  MinWidth="70" Height="32" FontSize="12"/>
          <Button Content="⬅️ 反转义" Command="{Binding UnescapeJsonCommand}"
                  MinWidth="75" Height="32" FontSize="12"/>
          <Separator Width="1" Height="20" VerticalAlignment="Center" Margin="4,0"/>

          <Button Content="🔄 交换" Command="{Binding SwapInputOutputCommand}"
                  MinWidth="60" Height="32" FontSize="12"/>
          <Button Content="📋 粘贴" Command="{Binding PasteFromClipboardCommand}"
                  MinWidth="60" Height="32" FontSize="12"/>
        </StackPanel>

        <!-- 右侧: 复制/清空 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Content="📄 复制" Command="{Binding CopyOutputCommand}"
                  MinWidth="70" Height="32" FontSize="12"
                  Background="#0078D4" Foreground="White"/>
          <Button Content="🗑️ 清空" Command="{Binding ClearAllCommand}"
                  MinWidth="60" Height="32" FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== 主编辑区: 左右分栏 ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="10,10,10,0">
      <!-- 左侧: 输入区 -->
      <Border Grid.Column="0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Padding="8,6"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="输入 (JSON)"
                         FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Text="{Binding InputCharCount, StringFormat='{}{0} 字符'}"/>
                <TextBlock FontSize="11" Text="|"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Text="{Binding InputLineCount, StringFormat='{}{0} 行'}"/>
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1">
            <TextBox Text="{Binding InputJson}"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap"
                     FontSize="{Binding EditorFontSize}"
                     FontFamily="Consolas"
                     Padding="8"
                     BorderThickness="0"
                     Background="Transparent"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- 中间分隔按钮 -->
      <Border Grid.Column="1" Width="40" VerticalAlignment="Center">
        <Button Content="→" Width="32" Height="32" FontSize="14"
                Command="{Binding FormatJsonCommand}"
                ToolTip.Tip="格式化"
                HorizontalAlignment="Center"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
      </Border>

      <!-- 右侧: 输出区 -->
      <Border Grid.Column="2"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Padding="8,6"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="输出"
                         FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                         Text="{Binding OutputStats}"/>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1">
            <TextBox Text="{Binding OutputText}"
                     AcceptsReturn="True"
                     TextWrapping="{Binding WordWrap}"
                     FontSize="{Binding EditorFontSize}"
                     FontFamily="Consolas"
                     Padding="8"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== 状态栏 ===== -->
    <Border Grid.Row="3"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                   FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" FontSize="11"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   VerticalAlignment="Center"
                   Text="缩进: 2 空格 | Ctrl+Enter 格式化"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
