<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UnitConverterPlugin.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="UnitConverterPlugin.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.DataContext>
        <vm:MainViewModel/>
    </UserControl.DataContext>

    <ScrollViewer Padding="30">
        <StackPanel Spacing="20" MaxWidth="500">
            <TextBlock Text="📐 单位换算器" FontSize="24" FontWeight="SemiBold"/>

            <!-- 类别选择 -->
            <StackPanel Spacing="6">
                <TextBlock Text="换算类别" FontSize="13" Foreground="#666666"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedIndex="{Binding CategoryIndex}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- 输入 -->
            <Border Background="#F5F5F5" CornerRadius="8" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="输入" FontWeight="Bold" FontSize="15"/>
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding InputValue}"
                                 Watermark="输入数值" FontSize="16"
                                 HorizontalAlignment="Stretch"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CurrentFromUnits}"
                                  SelectedIndex="{Binding FromUnitIndex}"
                                  MinWidth="120"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding CurrentToUnits}"
                                  SelectedIndex="{Binding ToUnitIndex}"
                                  MinWidth="120"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 交换按钮 -->
            <Button Content="⇅ 交换单位" Padding="12,8"
                    HorizontalAlignment="Center"
                    Background="#E8E8E8" BorderThickness="1"
                    CornerRadius="6"
                    Command="{Binding SwapUnitsCommand}"/>

            <!-- 输出 -->
            <Border Background="#E3F2FD" CornerRadius="8" Padding="15">
                <StackPanel Spacing="8">
                    <TextBlock Text="结果" FontWeight="Bold" FontSize="15" Foreground="#1565C0"/>
                    <TextBlock Text="{Binding OutputValue}" FontSize="32"
                               FontWeight="Light" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
